# Copy to .env. Keep credentials and tenant-specific values out of Git.
HOST=127.0.0.1
PORT=8787
DATA_MODE=demo
PUBLIC_ORIGIN=http://localhost:5173

# Live sign-in: see docs/SETUP.md. Only Worldwide work/school tenants currently targeted.
# DATA_MODE=live
# MICROSOFT_CLOUD=worldwide
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_ADMIN_OBJECT_IDS=
# ENABLED_READ_FEATURES=directory.users.read,user.licenses.read,audit.signins.read
# ENTRA_CERTIFICATE_PATH=/run/secrets/entra-public.pem
# ENTRA_PRIVATE_KEY_PATH=/run/secrets/entra-private.pem
# Development only; production requires the certificate pair above.
# ENTRA_CLIENT_SECRET=

# Generate unique credentials and a random 32-byte hex key before using live storage.
# DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@localhost:5432/prism365
# DATABASE_URL=postgresql://prism365_app:REPLACE@localhost:5432/prism365
# DATABASE_ADMIN_PASSWORD=
# DATABASE_APP_PASSWORD=
# STATE_ENCRYPTION_KEY=

# Module data without PostgreSQL: unset keeps it in memory (lost on restart). Set a directory to
# keep it on disk; that directory then holds tenant data.
# PRISM_DATA_DIR=./data/prism365

# Sign-in audit module (all optional). Countries where the organisation normally works, office or
# VPN egress ranges that should not raise location findings, and the zone for "usual hours".
# SIGNINS_EXPECTED_COUNTRIES=US,CA
# SIGNINS_TRUSTED_NETWORKS=192.0.2.0/24
# SIGNINS_TIME_ZONE=America/Chicago

# Optional read packs beyond the defaults, comma-separated in ENABLED_READ_FEATURES:
#   service.health.read    Microsoft service health (ServiceHealth.Read.All)
#   service.messages.read  Message center (ServiceMessage.Read.All)
#   tenant.licenses.read   License capacity audit (LicenseAssignment.Read.All, already
#                          enabled by user.licenses.read)
#   reports.authentication-methods.read  MFA registration audit (AuditLog.Read.All, already
#                          enabled by audit.signins.read)
# Each needs the matching delegated Graph permission, with admin consent, in the app registration.

# Reverse proxies in front of the API whose X-Forwarded-For entry gives the client address
# (0 to 3). The Docker install sets 1 for its Caddy proxy. Leave unset when nothing is in front.
# TRUST_PROXY_HOPS=1

# How long handoff records and imported receipts are kept, in days (30 to 3650). Default 1095.
# HANDOFF_RETENTION_DAYS=1095

# Optional local Ollama model already installed on the API host / shared loopback namespace.
# AI_LOCAL_MODEL=
# WEB_DIST_PATH=../../apps/web/dist
