{
  "name": "prism365",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source Microsoft 365 administration, reporting, and auditing platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:demo": "npm run build:demo --workspace @prism365/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev:api": "npm run dev --workspace @prism365/api",
    "dev:web": "npm run dev --workspace @prism365/web",
    "db:migrate": "npm run migrate --workspace @prism365/api",
    "demo:record": "tsx scripts/demo/record.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/setup/tsconfig.json",
    "demo": "npm run build:demo && npm run preview --workspace @prism365/web -- --outDir dist-demo",
    "setup": "node scripts/setup/main.ts"
  },
  "devDependencies": {
    "@azure/msal-node": "7.1.0",
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
